{
  "uid": "gregfana-players",
  "title": "Gregfana / Players",
  "description": "Lifetime = observed + optional imported baseline. Time is game ticks / 20, not wall time. Imports never affect activity rates. Missing data does not imply zero; check source health. Action/Item filter the per-item panels; 'used' includes block placement, 'Blocks placed' counts only placements since this feature was installed.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "gregfana",
    "gtnh"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "player",
        "label": "player",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gregfana-prometheus"
        },
        "query": "label_values(gregfana_player_info, player)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "action",
        "label": "Action",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gregfana-prometheus"
        },
        "query": "label_values(gregfana_player_stat_observed, action)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "item",
        "label": "Item",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gregfana-prometheus"
        },
        "query": "label_values(gregfana_player_stat_observed{action=~\"$action\"}, item)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Lifetime playtime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gregfana-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(gregfana_player_play_seconds_observed{player=~\"$player\"} + gregfana_player_play_seconds_imported{player=~\"$player\"}) * on(player) group_left(name) gregfana_player_info",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
