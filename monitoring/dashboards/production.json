{
  "uid": "gregfana-production",
  "title": "Gregfana / Production",
  "description": "Only supported processing is counted. Outputs are generated resources at completion, including voided output; they are not inventory deliveries. ME/dual-input/custom processing is unavailable. See coverage documentation.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "gregfana",
    "gtnh"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "machine",
        "label": "machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "gregfana-prometheus"
        },
        "query": "label_values(gregfana_machines_loaded, machine)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Loaded machines",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gregfana-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregfana_machines_loaded{machine=~\"$machine\"}",
          "legendFormat": "{{machine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Active machines",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gregfana-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregfana_machines_active{machine=~\"$machine\"}",
          "legendFormat": "{{machine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Supported configurations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gregfana-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregfana_machines_supported{machine=~\"$machine\"}",
          "legendFormat": "{{machine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Unsupported configurations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "gregfana-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregfana_machines_loaded{machine=~\"$machine\"} - gregfana_machines_supported{machine=~\"$machine\"}",
          "legendFormat": "{{machine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
